# ZKP Gateway API endpoint (proxied via Vite locally & Vercel in production to https://zkp-gateway.vercel.app)
VITE_ZKP_GATEWAY_URL=https://zkp-gateway.vercel.app
VITE_ZKP_API_ENDPOINT=/api/get-data

# Polling interval in milliseconds
VITE_POLL_INTERVAL_MS=1000

# Optional Direct ESP32 WebSocket URL & Serial Baud Rate
VITE_ESP32_WS_URL=ws://192.168.4.1:81
VITE_ESP32_BAUD_RATE=115200

